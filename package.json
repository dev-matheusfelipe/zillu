{
  "name": "zillu-screen",
  "version": "0.6.2",
  "private": true,
  "description": "Compartilhamento de tela por código",
  "main": "electron.cjs",
  "scripts": {
    "start": "npm run build:web && electron .",
    "server": "node server.cjs",
    "test": "node --test test/*.test.cjs",
    "dist:win": "npm run build:web && electron-builder --win portable --x64",
    "build:web": "node scripts/build-web.cjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12"
  },
  "build": {
    "appId": "studio.rizzer.zullu.screen",
    "productName": "Zillu",
    "asar": true,
    "files": [
      "electron.cjs",
      "preload.cjs",
      "server.cjs",
      "public/**/*",
      "package.json",
      "sfu/token.cjs",
      "cloud-server.cjs",
      "backend/api/index.js",
      "backend/lib/**/*",
      "backend/sfu/token.cjs"
    ],
    "win": {
      "target": "portable",
      "icon": "public/zillu.ico"
    },
    "artifactName": "Zillu-${version}-${arch}.${ext}"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "livekit-client": "^2.17.0"
  }
}
